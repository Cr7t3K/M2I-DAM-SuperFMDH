<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="{{ asset('images/favicon.png') }}" type="image/x-icon">
    <title>{% block title %}Annonces Immobilières{% endblock %}</title>
    <script src="https://kit.fontawesome.com/8a0ae65aed.js" crossorigin="anonymous"></script>
    <script src="https://cdn.tailwindcss.com"></script>

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% block header %}{% include '_partials/_header.html.twig' %}{% endblock %}

{% block body %}{% endblock %}

{% block footer %}{% include '_partials/_footer.html.twig' %}{% endblock %}
</body>
</html>
